automatic_id 1
script = collector_bot.lua
inputs = [ tick ]
# v - anim frame
# t - type frame
# f - fuel cells loaded
vars = { u8 v = 0 u8 t = 0 u8 f = 0 u8 c = 0 u8 s = 0 u8 n = 0 u16 q = 0 i16 x = 0 i16 y = 0 i16 h = 0 i16 k = 0 i16 d = 0 i16 e = 0 i16 a = 0 i16 b = 0 u32 T = 0 u32 D = 0 }
offset_x_controller = x
offset_y_controller = y
interp_timestamp_controller = T
interp_takes = 100
frame_controller = v
type_controller = t
texture = collector_bot.png